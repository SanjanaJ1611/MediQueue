# MediQueue Environment Configuration Example

# App Settings
APP_ENV=development
APP_DEBUG=true

# Database Settings (Leave default for MySQL or let it fallback to SQLite automatically)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mediqueue
DB_USER=root
DB_PASS=

# Supabase Authentication & Google OAuth Configuration
# Get these keys from your Supabase project dashboard:
# https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
